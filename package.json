{
  "name": "scopl-contracts",
  "version": "2.0.0",
  "private": true,
  "description": "SCOPL protocol smart contracts, reproducible artifacts, tests, and deployment tooling",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "compile": "node scripts/compile-contracts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run compile && npm run typecheck && npm test",
    "check:dependencies": "node scripts/check-contract-dependencies.mjs",
    "check:production": "node --env-file-if-exists=.env scripts/check-production-deployment.mjs",
    "check:blockscout": "node scripts/check-blockscout-verification.mjs",
    "check:v2:foundation": "npm run compile && node scripts/verify-order-foundation.mjs --check-only",
    "check:v2:managers": "npm run compile && node scripts/verify-order-foundation.mjs --managers --check-only",
    "check:hooks:pons": "node scripts/check-pons-v4-limit-orders.mjs",
    "check:hooks:long": "node scripts/check-long-v4-limit-orders.mjs",
    "verify:infrastructure": "node --env-file=.env scripts/verify-production-contracts.mjs",
    "verify:v2:foundation": "npm run compile && node scripts/verify-order-foundation.mjs",
    "verify:v2:managers": "npm run compile && node scripts/verify-order-foundation.mjs --managers",
    "deploy:v2:foundation:check": "npm run compile && node --env-file=.env scripts/deploy-order-foundation.mjs --dry-run",
    "deploy:v2:foundation": "npm run compile && node --env-file=.env scripts/deploy-order-foundation.mjs",
    "deploy:v2:v3-manager:check": "npm run compile && node --env-file=.env scripts/deploy-limit-order-manager.mjs --dry-run",
    "deploy:v2:v3-manager": "npm run compile && node --env-file=.env scripts/deploy-limit-order-manager.mjs",
    "deploy:v2:v4-manager:check": "npm run compile && node --env-file=.env scripts/deploy-v4-limit-order-manager.mjs --dry-run",
    "deploy:v2:v4-manager": "npm run compile && node --env-file=.env scripts/deploy-v4-limit-order-manager.mjs",
    "activate:v2:managers:check": "node --env-file=.env scripts/activate-order-managers.mjs --dry-run",
    "activate:v2:managers": "node --env-file=.env scripts/activate-order-managers.mjs",
    "activate:v2:revenue:check": "node --env-file-if-exists=.env scripts/configure-revenue-sources.mjs --dry-run",
    "activate:v2:revenue": "node --env-file=.env scripts/configure-revenue-sources.mjs",
    "ownership:audit": "node --env-file=.env scripts/check-ownership-migration.mjs --phase=before",
    "ownership:transfer:check": "node --env-file=.env scripts/transfer-ownership-to-safe.mjs",
    "ownership:transfer": "node --env-file=.env scripts/transfer-ownership-to-safe.mjs --broadcast",
    "ownership:accept:prepare": "node --env-file=.env scripts/prepare-safe-ownership-acceptance.mjs --write",
    "ownership:pending:check": "node --env-file=.env scripts/check-ownership-migration.mjs --phase=pending",
    "ownership:verify": "node --env-file=.env scripts/check-ownership-migration.mjs --phase=accepted"
  },
  "dependencies": {
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@types/node": "22.20.1",
    "solc": "0.8.26",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
